---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" solidHeader>
  <section class="notfound">
    <div class="container container--text">
      <p class="eyebrow">404</p>
      <h1 class="h1">That page drifted off</h1>
      <p class="lede notfound__body">
        The link may be out of date, or we may have moved something. The main page
        has everything.
      </p>
      <div class="notfound__actions">
        <a class="btn" href="/">Back to the residence</a>
        <a class="btn btn--ghost" href="/gallery">See the photos</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    padding-top: calc(var(--header-h) + var(--s-11));
    padding-bottom: var(--s-12);
  }
  .notfound__body { margin-top: var(--s-5); }
  .notfound__actions { margin-top: var(--s-7); display: flex; flex-wrap: wrap; gap: var(--s-4); }
</style>
