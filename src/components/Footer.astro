---
import { site, contact, nav, footer } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <p class="site-footer__name">{site.name}</p>
        <p class="site-footer__place">{site.location}</p>
        <p class="site-footer__note">{footer.note}</p>
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        <p class="site-footer__heading">Explore</p>
        <ul>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="site-footer__contact">
        <p class="site-footer__heading">Get in touch</p>
        <ul>
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          {contact.phone && (
            <li><a href={`tel:${contact.phoneHref}`}>{contact.phone}</a></li>
          )}
          <li><a href="/#inquire">Check availability</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      {footer.links.length > 0 && (
        <ul class="site-footer__links">
          {footer.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-ink);
    color: var(--c-bone);
    padding-block: var(--s-10) var(--s-7);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--s-8);
    padding-bottom: var(--s-9);
    border-bottom: 1px solid rgba(250, 248, 244, 0.14);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: var(--t-2xl);
    font-variation-settings: 'SOFT' 24, 'WONK' 1, 'opsz' 48;
    letter-spacing: var(--ls-snug);
  }

  .site-footer__place {
    font-size: var(--t-xs);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--c-sea-soft);
    margin-top: var(--s-2);
  }

  .site-footer__note {
    margin-top: var(--s-5);
    max-width: 26rem;
    color: rgba(250, 248, 244, 0.62);
    line-height: var(--lh-loose);
    font-size: 0.9375rem;
  }

  .site-footer__heading {
    font-size: var(--t-xs);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: rgba(250, 248, 244, 0.55);
    margin-bottom: var(--s-5);
  }

  :is(.site-footer__nav, .site-footer__contact) ul { display: grid; gap: var(--s-3); }

  :is(.site-footer__nav, .site-footer__contact) a {
    color: rgba(250, 248, 244, 0.82);
    font-size: 0.9375rem;
    transition: color var(--d-fast) var(--ease);
  }
  :is(.site-footer__nav, .site-footer__contact) a:hover { color: #fff; }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-6);
    justify-content: space-between;
    align-items: center;
    padding-top: var(--s-6);
    font-size: var(--t-sm);
    color: rgba(250, 248, 244, 0.55);
  }

  .site-footer__links { display: flex; gap: var(--s-5); }
  .site-footer__links a:hover { color: #fff; }

  @media (max-width: 52rem) {
    .site-footer__top { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }

  @media (max-width: 34rem) {
    .site-footer__top { grid-template-columns: 1fr; gap: var(--s-7); }
  }
</style>
