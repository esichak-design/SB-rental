---
import Photo from './Photo.astro';
import { hero, quickFacts } from '../data/site';
---

<section class="hero">
  <div class="hero__media">
    <Photo
      name={hero.image}
      alt={hero.imageAlt}
      sizes="100vw"
      widths={[768]}
      priority
    />
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__body container container--wide">
    <div class="hero__panel">
      <p class="hero__eyebrow">{hero.eyebrow}</p>
      <h1 class="display hero__headline">{hero.headline}</h1>
      <p class="hero__subhead">{hero.subhead}</p>
      <div class="hero__actions">
        <a class="btn btn--lg" href={hero.cta.href}>{hero.cta.label}</a>
        <a class="btn btn--lg btn--onDark" href={hero.secondaryCta.href}>
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>
  </div>

  <a class="hero__scroll" href="#the-residence" aria-label="Scroll to the residence details">
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<section class="facts" aria-label="At a glance">
  <ul class="facts__list container container--wide">
    {quickFacts.map((fact) => (
      <li class="facts__item">
        <span class="facts__value">{fact.value}</span>
        <span class="facts__label">{fact.label}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 62rem);
    display: flex;
    align-items: flex-end;
    padding-block: var(--s-12) var(--s-10);
    isolation: isolate;
    overflow: hidden;
  }

  .hero__media { position: absolute; inset: 0; z-index: -1; }
  /* :global is required — the <img> is rendered by the Photo component and so
     carries that component's scope id, not this one's. A plain `img` selector
     here is silently scoped to Hero and never matches. */
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Two stacked scrims: a broad bottom wash for text contrast, and a light
     top wash so the transparent header stays legible against a bright sky. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      /* Bottom wash, so the panel edge does not read as a hard cut-out. */
      linear-gradient(to top, rgba(8, 15, 20, 0.55) 0%, rgba(8, 15, 20, 0.18) 45%, rgba(8, 15, 20, 0) 75%),
      /* Top wash: the header sits directly on the photograph, and this hero's
         sky is bright enough to swallow white text without it. */
      linear-gradient(to bottom, rgba(8, 15, 20, 0.58) 0%, rgba(8, 15, 20, 0.28) 9%, rgba(8, 15, 20, 0) 20%);
  }

  .hero__body { color: #fff; }

  /* A scrim alone cannot carry this hero. Measured against the rendered pixels,
     even a heavy gradient left the headline at 2.0:1 on desktop and 1.1:1 on
     mobile, because the sunset sky is brightest exactly where the type sits —
     and darkening it far enough to fix that muddies the photograph. The panel
     puts a known ground under the text instead, and keeps the image readable
     around and through it. */
  .hero__panel {
    max-width: 46rem;
    padding: clamp(1.75rem, 3.5vw, 2.75rem) clamp(1.5rem, 3.5vw, 3rem) clamp(2rem, 3.5vw, 3rem);
    border-radius: var(--r-xl);
    border: 1px solid rgba(255, 255, 255, 0.1);
    /* Without backdrop-filter there is no blur to help, so the tint does more
       of the work. */
    background: rgba(8, 15, 20, 0.72);
  }

  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .hero__panel {
      background: rgba(8, 15, 20, 0.55);
      backdrop-filter: blur(22px) saturate(1.25);
      -webkit-backdrop-filter: blur(22px) saturate(1.25);
    }
  }

  .hero__eyebrow {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: var(--s-5);
    animation: heroIn var(--d-slow) var(--ease-out) both;
  }

  .hero__headline {
    color: #fff;
    max-width: 16ch;
    animation: heroIn var(--d-slow) var(--ease-out) 90ms both;
  }

  .hero__subhead {
    margin-top: var(--s-5);
    max-width: 44ch;
    font-size: var(--t-lg);
    line-height: var(--lh-loose);
    color: rgba(255, 255, 255, 0.9);
    text-wrap: pretty;
    animation: heroIn var(--d-slow) var(--ease-out) 180ms both;
  }

  .hero__actions {
    margin-top: var(--s-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    animation: heroIn var(--d-slow) var(--ease-out) 270ms both;
  }

  @keyframes heroIn {
    from { opacity: 0; transform: translateY(1.5rem); }
    to   { opacity: 1; transform: none; }
  }

  /* ── Scroll cue ─────────────────────────────────────────────────────────── */
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: var(--s-5);
    translate: -50% 0;
    width: 2.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
  }
  .hero__scroll-line {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.85) 100%);
    transform-origin: top;
    animation: drop 2.4s var(--ease) infinite;
  }

  @keyframes drop {
    0%        { transform: scaleY(0); opacity: 0; }
    35%, 65%  { transform: scaleY(1); opacity: 1; }
    100%      { transform: scaleY(1) translateY(100%); opacity: 0; }
  }

  /* ── Quick facts ────────────────────────────────────────────────────────── */
  .facts {
    background: var(--c-ink);
    color: var(--c-bone);
    padding-block: var(--s-6);
  }

  .facts__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .facts__item {
    display: grid;
    justify-items: center;
    gap: var(--s-1);
    text-align: center;
    padding-block: var(--s-2);
    border-left: 1px solid rgba(250, 248, 244, 0.15);
  }
  .facts__item:first-child { border-left: 0; }

  .facts__value {
    font-family: var(--font-display);
    font-size: var(--t-2xl);
    font-variation-settings: 'SOFT' 24, 'WONK' 0, 'opsz' 48;
    line-height: 1;
  }

  .facts__label {
    font-size: var(--t-xs);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--c-sea-soft);
  }

  @media (max-width: 40rem) {
    .hero { min-height: 92svh; }
    .hero__actions .btn { flex: 1 1 auto; }
    .facts__list { grid-template-columns: repeat(2, 1fr); row-gap: var(--s-5); }
    .facts__item:nth-child(odd) { border-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line { animation: none; opacity: 0.85; }
    :is(.hero__eyebrow, .hero__headline, .hero__subhead, .hero__actions) { animation: none; }
  }
</style>
