---
import { Image, Picture } from 'astro:assets';
import { getPhoto, isVector } from '../lib/photos';

interface Props {
  /** Bare filename as written in src/data/site.ts, e.g. "kitchen.jpg". */
  name: string;
  alt: string;
  /**
   * How wide the image renders at each breakpoint. Getting this right is what
   * makes the responsive srcset actually save bytes on a phone.
   */
  sizes?: string;
  /**
   * Candidate widths for the srcset. The source's own width is always added, so
   * these are the steps *below* native. Keep the list short: every entry is
   * another AVIF encode at build time, and AVIF is slow.
   */
  widths?: number[];
  /** Set on the hero only — eager-loads and raises fetch priority. */
  priority?: boolean;
  class?: string;
}

const {
  name,
  alt,
  sizes = '100vw',
  widths = [640, 1024],
  priority = false,
  class: className,
} = Astro.props;

const asset = getPhoto(name);

// WebP only, deliberately. Measured on this property's own photography at
// 1280px: JPEG 98KB, WebP 65KB, AVIF 59KB — but WebP encodes in 0.2s against
// AVIF's 4.4s. AVIF buys a further 9% for roughly 25x the build time, which
// across ~50 photos is minutes added to every deploy for a saving no visitor
// would notice. Worth revisiting if the source photos are ever re-exported
// much larger, where AVIF's advantage widens.

const shared = {
  src: asset,
  alt,
  class: className,
  loading: priority ? ('eager' as const) : ('lazy' as const),
  decoding: priority ? ('sync' as const) : ('async' as const),
  fetchpriority: priority ? ('high' as const) : ('auto' as const),
};

// Only offer widths the source can actually supply — upscaling wastes bytes
// and softens the image. The source's own width is always included, otherwise
// a 1280px original would top out at the next candidate down (1024) and throw
// away a fifth of the detail that is actually there.
const usableWidths = [...new Set([...widths.filter((w) => w < asset.width), asset.width])].sort(
  (a, b) => a - b,
);
---

{
  isVector(asset) ? (
    // SVG is resolution-independent; a srcset would be meaningless.
    <Image {...shared} width={asset.width} height={asset.height} />
  ) : (
    <Picture {...shared} formats={['webp']} widths={usableWidths} sizes={sizes} />
  )
}
