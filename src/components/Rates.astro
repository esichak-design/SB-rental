---
import { rates, ratesNotes } from '../data/site';
---

<section class="rates section" id="rates" aria-labelledby="rates-title">
  <div class="container container--wide">
    <div class="section-head reveal">
      <p class="eyebrow">Rates</p>
      <h2 class="h2" id="rates-title">{ratesNotes.headline}</h2>
      <p class="lede">{ratesNotes.body}</p>
    </div>

    <div class="rates__grid reveal reveal--stagger">
      {rates.map((season, i) => (
        <article class="season" style={`--i:${i}`}>
          <header class="season__head">
            <h3 class="season__name">{season.name}</h3>
            <p class="season__window">{season.window}</p>
          </header>
          <p class="season__price">
            <span class="season__amount">{season.nightly}</span>
            <span class="season__unit">/ night</span>
          </p>
          <p class="season__min">{season.minimum} minimum</p>
          {season.note && <p class="season__note">{season.note}</p>}
        </article>
      ))}
    </div>

    <div class="rates__detail reveal">
      <div class="fees">
        <h3 class="rates__sub">What's added</h3>
        <ul>
          {ratesNotes.fees.map((fee) => (
            <li class="fee">
              <div class="fee__what">
                <span class="fee__label">{fee.label}</span>
                <span class="fee__detail">{fee.detail}</span>
              </div>
              <span class="fee__value">{fee.value}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="policies">
        <h3 class="rates__sub">Booking &amp; cancellation</h3>
        <ul>
          {ratesNotes.policies.map((policy) => (
            <li class="policy">
              <span class="policy__dot" aria-hidden="true"></span>
              <span>{policy}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .rates__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--s-4);
  }

  .season {
    display: flex;
    flex-direction: column;
    padding: var(--s-6);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition: border-color var(--d-base) var(--ease), box-shadow var(--d-base) var(--ease);
  }
  .season:hover { border-color: var(--c-sea-soft); box-shadow: var(--sh-md); }

  .season__head { padding-bottom: var(--s-4); border-bottom: 1px solid var(--line); }

  .season__name {
    font-size: var(--t-xs);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--c-sea);
    font-weight: 600;
  }
  .season__window { margin-top: var(--s-2); font-size: 0.9375rem; color: var(--text-muted); }

  .season__price {
    margin-top: var(--s-5);
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
  }
  .season__amount {
    font-family: var(--font-display);
    font-size: var(--t-2xl);
    font-variation-settings: 'SOFT' 24, 'WONK' 0, 'opsz' 48;
    line-height: 1;
    letter-spacing: var(--ls-tight);
  }
  .season__unit { font-size: var(--t-sm); color: var(--text-subtle); }

  .season__min { margin-top: var(--s-3); font-size: 0.9375rem; color: var(--text-muted); }

  .season__note {
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px dashed var(--line);
    font-size: var(--t-sm);
    line-height: var(--lh-normal);
    color: var(--text-subtle);
    text-wrap: pretty;
  }

  /* ── Fees + policies ────────────────────────────────────────────────────── */
  .rates__detail {
    margin-top: var(--s-8);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-8);
    padding: var(--s-7);
    background: var(--c-sea-wash);
    border-radius: var(--r-lg);
  }

  .rates__sub {
    font-size: var(--t-xs);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--c-sea);
    font-weight: 600;
    margin-bottom: var(--s-5);
  }

  .fee {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid rgba(31, 78, 92, 0.14);
  }
  .fee:last-child { border-bottom: 0; }

  .fee__what { display: grid; gap: 2px; }
  .fee__label { font-weight: 500; }
  .fee__detail { font-size: var(--t-sm); color: var(--text-subtle); }
  .fee__value {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 20, 'opsz' 24;
    font-size: var(--t-lg);
    white-space: nowrap;
  }

  .policies ul { display: grid; gap: var(--s-4); }
  .policy {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-3);
    align-items: baseline;
    font-size: 0.9688rem;
    line-height: var(--lh-normal);
    color: var(--text-muted);
  }
  .policy__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c-sea-mid);
    translate: 0 -2px;
  }

  @media (max-width: 46rem) {
    .rates__detail { grid-template-columns: 1fr; gap: var(--s-7); padding: var(--s-6); }
  }
</style>
