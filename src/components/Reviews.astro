---
import { reviews } from '../data/site';
---

{reviews.length > 0 && (
  <section class="reviews section" aria-labelledby="reviews-title">
    <div class="container container--wide">
      <div class="section-head reveal">
        <p class="eyebrow">Guests</p>
        <h2 class="h2" id="reviews-title">What people say after</h2>
      </div>

      <ul class="reviews__grid reveal reveal--stagger">
        {reviews.map((review, i) => (
          <li class="review" style={`--i:${i}`}>
            <figure class="review__figure">
              <svg class="review__mark" width="30" height="24" viewBox="0 0 30 24" fill="none" aria-hidden="true">
                <path d="M12.4 0v9.1c0 6-2.6 11-8.3 14.9L0 20.2c3.4-2.4 5.4-5 5.9-7.8H2V0h10.4Zm17.6 0v9.1c0 6-2.7 11-8.4 14.9l-4-3.8c3.4-2.4 5.3-5 5.8-7.8h-3.8V0H30Z"
                      fill="currentColor"/>
              </svg>
              <blockquote class="review__quote"><p>{review.quote}</p></blockquote>
              <figcaption class="review__by">
                <span class="review__author">{review.author}</span>
                <span class="review__detail">{review.detail}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .reviews__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: var(--s-5);
  }

  .review__figure {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
    padding: var(--s-7);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-sm);
    transition: box-shadow var(--d-base) var(--ease), transform var(--d-base) var(--ease);
  }
  .review__figure:hover { box-shadow: var(--sh-md); transform: translateY(-2px); }

  .review__mark { color: var(--c-sea-mid); opacity: 0.55; }

  .review__quote {
    flex: 1;
    font-family: var(--font-display);
    font-size: var(--t-lg);
    font-variation-settings: 'SOFT' 24, 'WONK' 0, 'opsz' 22;
    line-height: 1.55;
    letter-spacing: var(--ls-snug);
    color: var(--text);
    text-wrap: pretty;
  }

  .review__by {
    display: grid;
    gap: var(--s-1);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .review__author { font-weight: 600; font-size: 0.9375rem; }
  .review__detail { font-size: var(--t-sm); color: var(--text-subtle); }
</style>
