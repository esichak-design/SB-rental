---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPhoto } from '../lib/photos';
import { site, hero } from '../data/site';

interface Props {
  /** Page title. The site name is appended automatically. */
  title?: string;
  description?: string;
  /** Bare filename from src/assets/photos, e.g. "living-room.jpg". */
  ogImage?: string;
  /** Hero pages draw the header over the image; inner pages need a solid one. */
  solidHeader?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = hero.image,
  solidHeader = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
// Social cards need a real, absolute raster. Resolved through the image
// pipeline rather than written as a path — the previous hardcoded
// "/images/hero.svg" quietly became a 404 when photos moved into src/assets,
// which nothing catches until someone shares the link and gets a blank card.
//
// JPEG rather than the site's usual WebP: some platform crawlers still do not
// take WebP. 1200x630 is the size the major platforms crop to.
const ogRendered = await getImage({
  src: getPhoto(ogImage),
  format: 'jpeg',
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'attention',
});
const ogImageUrl = new URL(ogRendered.src, Astro.site ?? site.url).href;

// Structured data helps this show up properly in search results.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: site.name,
  description: site.description,
  url: site.url,
  image: ogImageUrl,
  address: { '@type': 'PostalAddress', addressLocality: site.location },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1f4e5c" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogRendered.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(ogRendered.attributes.height ?? 630)} />
    <meta property="og:image:alt" content={hero.imageAlt} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={hero.imageAlt} />

    {/* Fonts are self-hosted (see src/styles/fonts.css). Preloading the two
        latin faces stops a flash of fallback type on first paint. */}
    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Set `.js` before paint so reveal animations never flash un-styled
        content, and so a JS-disabled visitor simply sees everything. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header solid={solidHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // ── Scroll reveal ──────────────────────────────────────────────────────
      // Content must never be left invisible by a decorative effect, so this
      // runs an IntersectionObserver for the animation plus a scroll-driven
      // sweep as a safety net.
      //
      // The sweep matters: IntersectionObserver coalesces its notifications at
      // frame boundaries, so a fast flick, a `scrollTo` jump, or a restored
      // scroll position can carry an element past the viewport without it ever
      // being reported as intersecting. Without the backstop that element stays
      // at `opacity: 0` forever.
      const targets = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const showAll = () => targets.forEach((el) => el.classList.add('is-visible'));

      if (reduced || !('IntersectionObserver' in window)) {
        showAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        targets.forEach((el) => io.observe(el));

        // Backstop: reveal anything that has reached the viewport but which the
        // observer did not report. Throttled to one check per frame.
        let queued = false;
        const sweep = () => {
          queued = false;
          const limit = window.innerHeight * 0.95;
          for (const el of targets) {
            if (el.classList.contains('is-visible')) continue;
            if (el.getBoundingClientRect().top < limit) {
              el.classList.add('is-visible');
              io.unobserve(el);
            }
          }
        };

        const scheduleSweep = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(sweep);
        };

        window.addEventListener('scroll', scheduleSweep, { passive: true });
        window.addEventListener('resize', scheduleSweep, { passive: true });
        window.addEventListener('load', scheduleSweep);
        scheduleSweep();
      }
    </script>
  </body>
</html>
